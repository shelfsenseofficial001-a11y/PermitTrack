# Copy this file to .env and fill in real values. .env is git-ignored so credentials
# never get committed. See api/config.php (load_env_file / app_config) for how this is read.

# Email verification codes
# MAIL_DRIVER=log        # 'log' (write to storage/outbox.log) or 'smtp'
MAIL_DRIVER=log
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_ENCRYPTION=tls
# (needs 2-Step Verification + an App Password; use the app password, not your login).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=you@gmail.com
SMTP_FROM_NAME=PermitTrack

# SMS verification codes
# SMS_DRIVER=log         # 'log', 'semaphore', 'twilio' or 'philsms'
SMS_DRIVER=log

# Semaphore (Philippines) — https://semaphore.co
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=PERMITTRACK

# PhilSMS (Philippines) — https://dashboard.philsms.com
PHILSMS_API_TOKEN=your-philsms-api-token
PHILSMS_SENDER_ID=PhilSMS

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM=+15005550006
